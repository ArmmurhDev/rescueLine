# ==============================================================================
# RescueLine - Web Server Security Hardening (.htaccess)
# Protects sensitive system files, environment configurations and credentials
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Prevent access to sensitive environment, schema, logs, and database files
<FilesMatch "^(\.env|\.git|\.htaccess|schema\.db|.*\.log|.*\.sql|requirement\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden files and directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# Security Headers (if mod_headers is active)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
