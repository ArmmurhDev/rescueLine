# RescueLine Environment Configuration Template

APP_NAME=RescueLine
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rescueline.ng
APP_KEY=generate_a_secure_64_character_hex_random_key_here
APP_TIMEZONE=Africa/Lagos

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=RescueLine
DB_USER=rescueline_user
DB_PASSWORD=your_secure_database_password
DB_CHARSET=utf8mb4

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# SMS Gateway API Configuration (Africa's Talking / Generic)
SMS_PROVIDER=africastalking
SMS_API_URL=https://api.africastalking.com/version1/messaging
SMS_USERNAME=sandbox
SMS_API_KEY=atsk_your_africas_talking_api_key_here
SMS_SENDER_ID=RescueLine

# USSD Gateway Configuration
USSD_SERVICE_CODE=*384*911#
USSD_API_SECRET=your_ussd_api_secret_or_key_here
